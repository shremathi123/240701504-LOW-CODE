	 			row = 1
	 			column = 1   
				width = medium
			)
			Medical_Asset
			(
				type = picklist	
				displayname = "Medical Asset "
				values  = Medical_Asset_Registry.ID
    			displayformat = [Asset_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Assigned_Technician
			(
				type = picklist	
				displayname = "Assigned Technician"
				values  = Technician_Management.ID
    			displayformat = [" " + Technician_Name.prefix + " " + Technician_Name.first_name + " " + Technician_Name.last_name + " " + Technician_Name.suffix]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Calibration_Date
			(
    			type = date
				displayname = "Calibration Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Next_Due_Date
			(
    			type = date
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Calibration_Result
			(
				type = picklist
				displayname = "Calibration Result"
				maxchar = 100
				values = {"Pending","Passed","Failed","Requires Investigation"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Calibration_Method
			(
				type = picklist
				displayname = "Calibration Method"
				maxchar = 100
				values = {"Electrical Testing","Functional Testing","eference Instrument Comparison","Manufacturer Procedure","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Observed_Readings
			(
    			type = textarea
				displayname = "Observed Readings"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Reference_Standard_Used
			(
    			type = text
				displayname = "Reference Standard Used"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Remarks
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Calibration_Certificate
			(
    			type = upload file
				displayname = "Calibration Certificate"
    			file count = 10
				browse = local_drive
	 			row = 1
	 			column = 1   
				width = medium
			)
			Supervisor_Approval
			(
				type = picklist
				displayname = "Supervisor Approval"
				maxchar = 100
				values = {"Pending Review","Approved","Rejected"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Calibration_Checklist
			(
				type = grid
				displayname = "Calibration Checklist"
				Test_Parameter
				(
    				type = text
					displayname = "Test Parameter"
					width = medium
				)
				Expected_Value
				(
    				type = text
					displayname = "Expected Value"
					width = medium
				)
				Observed_Value
				(
    				type = text
					displayname = "Observed Value"
					width = medium
				)
				Unit
				(
    				type = text
					width = medium
				)
				Test_Result
				(
					type = picklist
					displayname = "Test Result"
					maxchar = 100
					values = {"Pass","Fail","Not Applicable"}
					width = medium
				)
				Technician_Remarks
				(
    				type = textarea
					displayname = "Technician Remarks"
					height = 100px
					width = medium
				)
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
