		workflow
		{
		form
		{
			Calibration_Deadline_Moni as "Calibration_Deadline_Monitor"
			{
				type =  form
				form = Calibration_Management

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Next_Due_Date != null)
										{
											if(input.Next_Due_Date < zoho.currentdate)
											{
												info "ALERT: Calibration is overdue!";
											}
											else if(input.Next_Due_Date <= zoho.currentdate.addDay(7))
											{
												info "WARNING: Calibration is due within 7 days.";
											}
											else
											{
												info "Calibration is not due yet.";
											}
										}
						)
					}
					actions 
					{
						sendmail
						(
							from : "zoho.loginuserid"
							to : "shremathi.k.2024.cse@rajalakshmi.edu.in"
							subject : "Tele-ICU - Calibration Deadline Alert"
							message : "<div>TELE-ICU CALIBRATION ALERT <br></div><div><br></div><div>Dear Team,<br></div><div><br></div><div>A calibration record has been added or updated in the Tele-ICU Smart Asset &amp; Remote Calibration Network.<br></div><div><br></div><div>Please review the calibration details and take the necessary action.<br></div><div><br></div><div>Required Actions:<br></div><div>1. Open the Calibration Management section.<br></div><div>2. Verify the medical asset and assigned technician.<br></div><div>3. Check the next calibration due date.<br></div><div>4. Schedule calibration if the due date is approaching.<br></div><div>5. Arrange immediate calibration if the deadline has passed.<br></div><div><br></div><div>Please ensure all medical equipment is properly calibrated and its records are up to date to support patient safety and reliable ICU operations.<br></div><div><br></div><div>This is an automated notification from the Tele-ICU Smart Asset &amp; Remote Calibration Network.<br></div><div><br></div><div>Regards,<br></div><div>Tele-ICU Asset Management System<br></div>"
							content type : Plain Text
							attachments : template : _default1 as inline
						)
					}
				}

			}
			Maintenance_Request_Notif as "Maintenance_Request_Notification"
			{
				type =  form
				form = Maintenance_Requests

				record event = on add

				on success
				{
					actions 
					{
						sendmail
						(
							from : "zoho.loginuserid"
							to : "shremathi.k.2024.cse@rajalakshmi.edu.in"
							subject : "New Maintenance Request - Tele-ICU Asset Management"
							message : "<div>A new maintenance request has been submitted. Please log in to Tele-ICU Asset Management to review the request and take the necessary action. <br></div>"
						)
					}
				}

			}
		}

		schedule
		{
			Daily_Calibration_Reminde as "Daily_Calibration_Reminder"
			{
				type =  schedule
				start = "2026-10-15 09:00:00"
				frequency = daily
				time zone = "UTC"
				on start
				{
					actions 
					{
					on load
					(
						today = zoho.currentdate;
										dueSoon = today.addDay(7);
										records = Calibration_Management[Next_Due_Date != null];
										emailBody = "";
										for each  record in records
										{
											if(record.Next_Due_Date < today)
											{
												emailBody = emailBody + "OVERDUE CALIBRATION\n";
												emailBody = emailBody + "Calibration ID: " + record.Calibration_ID + "\n";
												emailBody = emailBody + "Due Date: " + record.Next_Due_Date + "\n\n";
											}
											else if(record.Next_Due_Date <= dueSoon)
											{
												emailBody = emailBody + "UPCOMING CALIBRATION\n";
												emailBody = emailBody + "Calibration ID: " + record.Calibration_ID + "\n";
												emailBody = emailBody + "Due Date: " + record.Next_Due_Date + "\n\n";
											}
										}
										if(emailBody != "")
										{
											sendmail
											[
												from :zoho.loginuserid
												to :"shremathi.k.2024.cse@rajalakshmi.edu.in"
												subject :"Calibration Deadline Alert - Tele-ICU Asset Management"
												message :emailBody
											]
										}
					)
					}
				}
			}
		}




