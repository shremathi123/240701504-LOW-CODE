	 			column = 1   
				width = medium
			)
			Transfer_Document
			(
    			type = upload file
				displayname = "Transfer Document"
    			file count = 10
				browse = local_drive
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Calibration_Management
		{
			displayname = "Calibration Management"
