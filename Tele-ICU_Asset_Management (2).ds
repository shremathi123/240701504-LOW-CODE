	reports
	{
		default list All_Hospital_Management
		{
			displayName = "All Hospital Management"
			show all rows from Hospital_Management    
			(
				Hospital_ID as "Hospital ID"
				Hospital_Name as "Hospital Name"
				Hospital_Code as "Hospital Code"
				Address
				City
				State
				Contact_Person as "Contact Person"
				Contact_Email as "Contact Email"
				Contact_Phone as "Contact Phone"
