	 			row = 1
	 			column = 1   
				width = medium
			)
			Requested_By
			(
    			type = text
				displayname = "Requested By"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Request_Date
			(
    			type = date
				displayname = "Request Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Proposed_Transfer_Date
			(
    			type = date
				displayname = "Proposed Transfer Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Actual_Transfer_Date
			(
    			type = date
				displayname = "Actual Transfer Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Transfer_Reason
			(
				type = picklist
				displayname = "Transfer Reason"
				maxchar = 100
				values = {"Equipment Redistribution","Maintenance","Calibration","Emergency Requirement","Department Requirement","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Approval_Status
			(
				type = picklist
				displayname = "Approval Status"
				maxchar = 100
				values = {"Pending Approval","Approved","Rejected"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Transfer_Status
			(
				type = picklist
				displayname = "Transfer Status"
				maxchar = 100
				values = {"Requested","Approved","In Transit","Received","Cancelled"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Approved_By
			(
    			type = text
				displayname = "Approved By"
