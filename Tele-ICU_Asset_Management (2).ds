 application "Tele-ICU Asset Management"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "UTC"
 	time format = "24-hr"

 	forms
	{
		form Approval_Request
		{
			displayname = "Approval Request"
			success message = "Leave Request Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			plain
			(
    			type = plaintext
				value = "<p class=\"zw-paragraph heading0\" style=\"margin: 0px 0px 0pt; line-height: 1.2; text-align: left; direction: ltr\"><span style=\"color: rgb(0, 0, 0)\" class=\"colour\"><span style=\"font-family: Lato\" class=\"font\"><span style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400\" class=\"size\">💡 </span></span><b><span style=\"font-family: Lato\" class=\"font\"><span style=\"font-size: 12pt; vertical-align: baseline\" class=\"size\">Creator tip:</span></span></b><span style=\"font-family: Lato\" class=\"font\"><span style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400\" class=\"size\"> Use this sample form to capture data. Below is an example of how it may look.</span></span></span>\n <br></p>\n<p class=\"zw-paragraph heading0\" style=\"margin: 0px 0px 0pt; line-height: 1.2; text-align: left; direction: ltr\">\n <br>\n</p>\n<div>\n <span style=\"color: rgb(0, 0, 0)\" class=\"colour\"><span style=\"font-family: Lato\" class=\"font\"><span style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400\" class=\"size\">Feel free to tweak things via the form builder. Every form submission is recorded in a report and can be visualized</span></span></span>\n <br>\n</div>\n<div>\n <br>\n</div>\n<div>\n <span style=\"color: rgb(0, 0, 0)\" class=\"colour\"><span style=\"font-family: Lato\" class=\"font\"><span style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400\" class=\"size\">If you're looking for a guide to help you with approvals, </span></span></span> <a rel=\"noopener noreferrer\" target=\"_blank\" href=\"https://youtu.be/b48IRlkvazM\" style=\"color: rgb(0, 0, 255)\"><span style=\"font-family: Lato\" class=\"font\"><span style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400\" class=\"size\">our video tutorial is here for you</span></span><span class=\"zw-portion\" style=\"\">.</span></a>\n <br>\n</div>\n<p class=\"zw-paragraph heading0\" style=\"margin: 0px 0px 0pt; line-height: 1.2; text-align: left; direction: ltr\"><span class=\"EOP\">&nbsp;</span>\n <br></p>\n<p class=\"zw-paragraph heading0\" style=\"margin: 0px 0px 0pt; line-height: 1.2; text-align: left; direction: ltr\"><span style=\"color: rgb(0, 0, 0)\" class=\"colour\"><span style=\"font-family: Lato\" class=\"font\"><span style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400\" class=\"size\">N</span></span></span><span style=\"color: rgb(0, 0, 0)\" class=\"colour\"><span style=\"font-family: Lato\" class=\"font\"><span style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400\" class=\"size\">ote:</span></span></span><span style=\"color: rgb(0, 0, 0)\" class=\"colour\"><span style=\"font-family: Lato\" class=\"font\"><span style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400\" class=\"size\"> If you're capturing sensitive data via a field, </span></span></span><span style=\"color: rgb(0, 0, 0)\" class=\"colour\"><span style=\"font-family: Lato\" class=\"font\"><span style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400\" class=\"size\">take a look at its properties to make it secured.</span></span></span>\n <br></p>\n<div>\n <br>\n</div>"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have unique Employee_Id
			(
    			type = text
				displayname = "Employee Id"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Department
			(
				type = picklist
				maxchar = 100
				values = {"Sales","Marketing","Operations","Finance","Packaging"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Type_of_Leave
			(
				type = picklist
				displayname = "Type of Leave"
				maxchar = 100
				values = {"Sick Leave","Casual Leave","Public Holiday"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Start_Date
			(
    			type = date
				displayname = "Start Date"
				initial value = "${zoho.currentdate}"
				alloweddays = 1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have End_Date
			(
    			type = date
				displayname = "End Date"
				alloweddays = 1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Reason
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Asset_Transfer_Management
		{
			displayname = "Asset Transfer Management"
			success message = "Asset Transfer Management Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Transfer_ID
			(
    			type = autonumber
				displayname = "Transfer ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			Medical_Asset
			(
				type = picklist	
				displayname = "Medical Asset "
				values  = Medical_Asset_Registry.ID
    			displayformat = [Asset_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Source_Hospital
			(
				type = picklist	
				displayname = "Source Hospital"
				values  = Hospital_Management.ID
    			displayformat = [Hospital_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Destination_Hospital
			(
				type = picklist	
				displayname = "Destination Hospital"
				values  = Hospital_Management.ID
    			displayformat = [Hospital_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Source_ICU
			(
				type = picklist	
				displayname = "Source ICU"
				values  = ICU_Department_Management.ID
    			displayformat = [ICU_Name]
				sortorder = ascending
