			roles
			{
				"CEO"
				{
					description = "User belonging to this role can access data of all other users."
					"Manager"
					{
						description = ""
					}
				}
			}
			Sharing_Rules
			{
				"Calibration_Data_Sharing"
				{
					form = "Calibration_Management"
					sharedFromType = Roles
					sharedToType = Roles
					levelOfAccess = "Read"
					sharedFrom = "Manager"
					sharedTo = "CEO"
				}
			}
	}

